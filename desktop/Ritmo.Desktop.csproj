<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Ritmo</AssemblyName>
    <RootNamespace>Ritmo</RootNamespace>
    <Version>1.3.1</Version>
    <ApplicationIcon>Assets/ritmo.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><Resource Include="Assets/ritmo.ico" /></ItemGroup>
</Project>
